# Token de ton bot Discord (Portail Développeur Discord)
DISCORD_TOKEN=ton_token_ici

# ID de ton application Discord
CLIENT_ID=ton_client_id_ici

# ID du serveur Discord (pour déployer les commandes)
GUILD_ID=ton_guild_id_ici

# Salon où le bot envoie les rappels automatiques (ID du salon)
REMINDER_CHANNEL_ID=ton_channel_id_ici

# Ville et pays par défaut pour les horaires
DEFAULT_CITY=Paris
DEFAULT_COUNTRY=France

# Méthode de calcul des horaires de prière
# 12 = Union des Organisations Islamiques de France (recommandé pour la France)
# 2  = Islamic Society of North America (ISNA)
# 3  = Muslim World League
PRAYER_METHOD=12
